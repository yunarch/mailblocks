{
  "$schema": "https://json.schemastore.org/package",
  "private": true,
  "name": "@yunarch/mailblocks",
  "version": "0.0.0",
  "description": "Email template editor built with React Email.",
  "license": "MIT",
  "author": {
    "name": "Adrian Lopez Gonzalez",
    "url": "https://github.com/yunarch"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yunarch/mailblocks.git"
  },
  "bugs": {
    "url": "https://github.com/yunarch/mailblocks/issues"
  },
  "type": "module",
  "scripts": {
    "prepare": "husky",
    "lint": "bun run --parallel lint:code lint:ts",
    "lint:ts": "tsc --noEmit",
    "lint:code": "eslint .",
    "lint:code:fix": "eslint --fix .",
    "format": "oxfmt --check",
    "format:fix": "oxfmt",
    "clean": "rimraf dist tmp .eslintcache .vitest .vitest-attachments",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "tests": "vitest run",
    "tests:watch": "vitest",
    "tests:coverage": "vitest run --coverage",
    "tests:standard": "vitest run --project standard",
    "tests:browser": "vitest run --project browser",
    "gen:templates": "bun run scripts/sync-react-email-templates.ts"
  },
  "dependencies": {
    "tailwindcss": "4.3.3",
    "tailwind-merge": "3.7.0",
    "tailwind-variants": "3.3.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-icons": "5.7.0",
    "react-email": "6.11.5",
    "@react-email/editor": "1.7.16",
    "caniemail": "2.0.2"
  },
  "devDependencies": {
    "@yunarch/config-web": "0.10.1",
    "husky": "9.1.7",
    "rimraf": "6.1.3",
    "oxfmt": "0.75.0",
    "eslint": "10.13.0",
    "vite": "8.3.5",
    "@tailwindcss/vite": "4.3.3",
    "@vitejs/plugin-react": "6.1.2",
    "vitest": "5.0.5",
    "vitest-browser-react": "2.3.0",
    "@vitest/browser": "5.0.5",
    "@vitest/browser-playwright": "5.0.5",
    "@vitest/coverage-v8": "5.0.5",
    "typescript": "6.0.3",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0"
  },
  "engines": {
    "bun": ">=1.3.9"
  },
  "packageManager": "bun@1.4.4"
}
