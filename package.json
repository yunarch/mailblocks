{
  "$schema": "https://json.schemastore.org/package",
  "private": true,
  "name": "@yunarch/mailblocks",
  "version": "0.0.0",
  "description": "Email template editor built with React Email.",
  "license": "MIT",
  "author": {
    "name": "Adrian Lopez Gonzalez",
    "url": "https://github.com/yunarch"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yunarch/mailblocks.git"
  },
  "bugs": {
    "url": "https://github.com/yunarch/mailblocks/issues"
  },
  "type": "module",
  "engines": {
    "bun": ">=1.3.9"
  },
  "scripts": {
    "prepare": "husky",
    "lint": "bun run --parallel lint:code lint:ts",
    "lint:ts": "tsc --noEmit",
    "lint:code": "oxlint .",
    "lint:code:fix": "oxlint . --fix",
    "format": "oxfmt format --check ./",
    "format:all": "oxfmt format --write ./",
    "clean": "rimraf dist",
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "@react-email/editor": "1.4.1",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-icons": "5.6.0",
    "tailwindcss": "4.3.0",
    "tailwind-merge": "3.6.0"
  },
  "devDependencies": {
    "@yunarch/config-web": "0.9.1",
    "husky": "9.1.7",
    "rimraf": "6.1.3",
    "oxfmt": "0.50.0",
    "oxlint": "1.65.0",
    "oxlint-tsgolint": "0.22.1",
    "vite": "8.0.13",
    "@tailwindcss/vite": "4.3.0",
    "@vitejs/plugin-react": "6.0.2",
    "typescript": "6.0.3",
    "@types/node": "25.8.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3"
  },
  "packageManager": "bun@1.3.14"
}
