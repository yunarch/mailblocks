{
  "$schema": "https://json.schemastore.org/package",
  "private": true,
  "name": "@yunarch/mailblocks",
  "version": "0.0.0",
  "description": "A drag-and-drop email canvas that generates production-ready HTML.",
  "license": "MIT",
  "author": {
    "name": "Adrian Lopez Gonzalez",
    "url": "https://github.com/yunarch"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yunarch/mailblocks.git"
  },
  "bugs": {
    "url": "https://github.com/yunarch/mailblocks/issues"
  },
  "type": "module",
  "engines": {
    "bun": ">=1.3.9"
  },
  "scripts": {
    "prepare": "husky",
    "lint": "bun run --parallel lint:code lint:ts",
    "lint:ts": "tsc --noEmit",
    "lint:code": "oxlint .",
    "lint:code:fix": "oxlint . --fix",
    "format": "oxfmt format --check ./",
    "format:all": "oxfmt format --write ./"
  },
  "dependencies": {},
  "devDependencies": {
    "@yunarch/config-web": "0.7.8",
    "husky": "9.1.7",
    "oxfmt": "0.44.0",
    "oxlint": "1.59.0",
    "oxlint-tsgolint": "0.20.0",
    "rimraf": "6.1.3",
    "typescript": "6.0.2"
  },
  "packageManager": "bun@1.3.11"
}
