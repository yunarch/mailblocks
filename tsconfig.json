{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "@yunarch/config-web/tsconfig-base",
  "compilerOptions": {
    "target": "es2024",
    "lib": ["ES2024", "DOM"],
    "jsx": "react-jsx",
    "paths": {
      "@/*": ["./src/*"]
    },
    "types": ["node", "vite/client"]
  },
  "include": ["./src", "./scripts", "./reset.d.ts", "./*.config.ts"]
}
